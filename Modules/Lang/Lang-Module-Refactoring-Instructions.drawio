<mxfile host="app.diagrams.net" modified="2026-03-02T00:00:00.000Z" agent="Claude" version="24.0.0" type="device">
  <diagram id="lang-full-flow" name="Lang Module - Full Flow with FE Calls">
    <mxGraphModel dx="2200" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== TITLE ==================== -->
        <mxCell id="title" value="Lang Module - Full Flow (FE &amp;rarr; BE &amp;rarr; JSON Generation)" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="No Section entity &amp;mdash; SectionSlug is a plain string on Translation" style="text;html=1;fontSize=13;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="700" y="55" width="600" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== FE (BROWSER) SWIM LANE ==================== -->
        <mxCell id="fe-lane" value="Frontend (Browser)" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="560" height="1650" as="geometry" />
        </mxCell>

        <!-- FE: App Init -->
        <mxCell id="fe-init" value="App Init / Route Change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;" vertex="1" parent="fe-lane">
          <mxGeometry x="180" y="50" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- FE: Fetch JSON -->
        <mxCell id="fe-fetch-json" value="GET /translations/{lang}/{section}.json&#xa;&#xa;e.g. GET /translations/cs/auth.json&#xa;(Anonymous, no auth needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="fe-lane">
          <mxGeometry x="120" y="120" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fe-init-to-fetch" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="fe-lane" source="fe-init" target="fe-fetch-json">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE: Store translations -->
        <mxCell id="fe-store" value="Store in memory / state manager&#xa;{ slug: translatedValue }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="fe-lane">
          <mxGeometry x="150" y="220" width="260" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fe-fetch-to-store" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="fe-lane" source="fe-fetch-json" target="fe-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE: API call that may fail -->
        <mxCell id="fe-api-call" value="FE makes any API call&#xa;e.g. POST /api/auth/login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="fe-lane">
          <mxGeometry x="170" y="300" width="220" height="45" as="geometry" />
        </mxCell>
        <mxCell id="fe-store-to-api" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="fe-lane" source="fe-store" target="fe-api-call">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE: API returns error -->
        <mxCell id="fe-error" value="API returns ErrorOr error&#xa;{ code: &quot;auth-api-authService-invalidPassword&quot;,&#xa;  description: &quot;Neplatn&#233; heslo&quot; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="fe-lane">
          <mxGeometry x="100" y="380" width="360" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fe-api-to-error" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="fe-lane" source="fe-api-call" target="fe-error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE: Lookup translation -->
        <mxCell id="fe-lookup" value="Lookup error.code in loaded translations&#xa;slug = &quot;auth-api-authService-invalidPassword&quot;&#xa;&#x2192; found: &quot;Neplatn&#233; heslo&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="fe-lane">
          <mxGeometry x="110" y="465" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fe-error-to-lookup" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="fe-lane" source="fe-error" target="fe-lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE: Show to user -->
        <mxCell id="fe-show" value="Display translated error message to user" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="fe-lane">
          <mxGeometry x="160" y="550" width="240" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fe-lookup-to-show" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="fe-lane" source="fe-lookup" target="fe-show">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ====== FE: Admin CRUD Section ====== -->
        <mxCell id="fe-admin-divider" value="" style="line;strokeWidth=2;strokeColor=#999999;" vertex="1" parent="fe-lane">
          <mxGeometry x="30" y="630" width="500" height="10" as="geometry" />
        </mxCell>
        <mxCell id="fe-admin-label" value="Admin Panel (Translation Management)" style="text;html=1;fontSize=14;fontStyle=1;align=center;fontColor=#333333;" vertex="1" parent="fe-lane">
          <mxGeometry x="100" y="650" width="340" height="25" as="geometry" />
        </mxCell>

        <!-- FE: List Languages -->
        <mxCell id="fe-list-langs" value="GET /api/lang/languages&#xa;[Anonymous]&#xa;&#xa;List all languages (Cs, En, De...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="fe-lane">
          <mxGeometry x="20" y="690" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- FE: Toggle Language -->
        <mxCell id="fe-toggle-lang" value="PUT /api/lang/languages/{shortcut}&#xa;[Authorized]&#xa;&#xa;{ isActive: true/false }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="fe-lane">
          <mxGeometry x="280" y="690" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- FE: List Section Slugs -->
        <mxCell id="fe-list-sections" value="GET /api/lang/sections&#xa;[Authorized]&#xa;&#xa;Returns DISTINCT section slugs&#xa;[&quot;auth&quot;, &quot;lang&quot;, &quot;shared&quot;, &quot;mmo&quot;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="fe-lane">
          <mxGeometry x="20" y="780" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- FE: List Translations -->
        <mxCell id="fe-list-trans" value="GET /api/lang/translations&#xa;[Anonymous]&#xa;&#xa;Paginated, filterable by&#xa;SectionSlug, LanguageShortcut, Slug" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="fe-lane">
          <mxGeometry x="280" y="780" width="250" height="80" as="geometry" />
        </mxCell>

        <!-- FE: Create Translations -->
        <mxCell id="fe-create-trans" value="POST /api/lang/translations&#xa;[Anonymous]&#xa;&#xa;{ sectionSlug: &quot;auth&quot;,&#xa;  languageShortcut: &quot;Cs&quot;,&#xa;  items: [{ slug, value }, ...] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=0;" vertex="1" parent="fe-lane">
          <mxGeometry x="20" y="890" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- FE: Update Translation -->
        <mxCell id="fe-update-trans" value="PUT /api/lang/translations/{id}&#xa;[Authorized]&#xa;&#xa;{ value: &quot;New translation text&quot; }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="fe-lane">
          <mxGeometry x="280" y="890" width="250" height="70" as="geometry" />
        </mxCell>

        <!-- FE: Delete Translation -->
        <mxCell id="fe-delete-trans" value="DELETE /api/lang/translations/{id}&#xa;[Authorized]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="fe-lane">
          <mxGeometry x="280" y="975" width="250" height="40" as="geometry" />
        </mxCell>

        <!-- FE: Note about SectionSlug -->
        <mxCell id="fe-section-note" value="Note: SectionSlug is a plain string&#xa;(e.g. &quot;auth&quot;, &quot;lang&quot;, &quot;shared&quot;, &quot;mmo-settings&quot;).&#xa;FE decides the section when creating translations.&#xa;No Section CRUD needed." style="text;html=1;fontSize=10;fontStyle=2;fontColor=#888888;align=left;" vertex="1" parent="fe-lane">
          <mxGeometry x="20" y="1000" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== BE API LAYER ==================== -->
        <mxCell id="be-lane" value="Backend API (ASP.NET Minimal API)" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="100" width="500" height="1650" as="geometry" />
        </mxCell>

        <!-- BE: Static File Middleware -->
        <mxCell id="be-static" value="Static File Middleware&#xa;&#xa;/translations/{lang}/{section}.json&#xa;served from wwwroot/translations/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="be-lane">
          <mxGeometry x="100" y="50" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- BE: MediatR Pipeline -->
        <mxCell id="be-mediatr" value="MediatR Pipeline&#xa;&#xa;Endpoint &#x2192; Command/Query &#x2192; Handler&#xa;&#x2192; LangPostCommandBehavior (auto-save)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="be-lane">
          <mxGeometry x="50" y="160" width="400" height="70" as="geometry" />
        </mxCell>

        <!-- BE: Language Handlers -->
        <mxCell id="be-lang-handlers" value="Language Handlers&#xa;&#xa;CreateLanguageCommandHandler&#xa;UpdateLanguageCommandHandler&#xa;ListLanguagesQueryHandler&#xa;GetLanguageByShortcutQueryHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="be-lane">
          <mxGeometry x="20" y="270" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- BE: Translation Handlers -->
        <mxCell id="be-trans-handlers" value="Translation Handlers&#xa;&#xa;CreateTranslationsCommandHandler&#xa;UpdateTranslationCommandHandler&#xa;RemoveTranslationCommandHandler&#xa;ListTranslationsQueryHandler&#xa;GetTranslationByIdQueryHandler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="be-lane">
          <mxGeometry x="260" y="270" width="220" height="105" as="geometry" />
        </mxCell>

        <!-- BE: Section Slugs Query -->
        <mxCell id="be-section-query" value="ListSectionSlugsQueryHandler&#xa;&#xa;SELECT DISTINCT SectionSlug&#xa;FROM Translations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="be-lane">
          <mxGeometry x="120" y="400" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- BE: Marten Event Store -->
        <mxCell id="be-marten" value="Marten (PostgreSQL)&#xa;Event Store + Document Projections&#xa;&#xa;Language aggregate&#xa;Translation aggregate (with SectionSlug string)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="be-lane">
          <mxGeometry x="60" y="500" width="380" height="80" as="geometry" />
        </mxCell>

        <!-- BE: Arrow MediatR to Marten -->
        <mxCell id="be-handlers-to-marten" style="edgeStyle=orthogonalEdgeStyle;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="be-lane" source="be-trans-handlers" target="be-marten">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be-langhandlers-to-marten" style="edgeStyle=orthogonalEdgeStyle;html=1;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="be-lane" source="be-lang-handlers" target="be-marten">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- BE: Publish MassTransit -->
        <mxCell id="be-publish" value="Publish MassTransit message&#xa;&#xa;TranslationSectionChanged&#xa;{ SectionSlug, LanguageShortcut }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=11;" vertex="1" parent="be-lane">
          <mxGeometry x="100" y="620" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- BE: Arrow handlers to publish -->
        <mxCell id="be-trans-to-publish" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="be-lane" source="be-marten" target="be-publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="be-publish-label" value="After Create / Update / Delete&#xa;translation command" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#888888;" vertex="1" parent="be-lane">
          <mxGeometry x="310" y="590" width="170" height="30" as="geometry" />
        </mxCell>

        <!-- BE: Seed -->
        <mxCell id="be-seed" value="TranslationsSeed (Reflection-Based)&#xa;&#xa;Scans all assemblies for:&#xa;&#x2022; IErrorComponentSlugProvider&#xa;&#x2022; ITranslatable&#xa;&#xa;Groups by SectionSlug (module part of slug)&#xa;Creates translations via MediatR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6d0de;strokeColor=#996185;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="be-lane">
          <mxGeometry x="70" y="750" width="360" height="120" as="geometry" />
        </mxCell>

        <!-- ==================== RABBITMQ + CONSUMER LANE ==================== -->
        <mxCell id="mq-lane" value="RabbitMQ + MassTransit Consumer" style="swimlane;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1180" y="100" width="500" height="1650" as="geometry" />
        </mxCell>

        <!-- MQ: RabbitMQ Queue -->
        <mxCell id="mq-queue" value="RabbitMQ Queue&#xa;&#xa;module-lang-translation-section-changed" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;size=15;fontSize=11;fontStyle=1;" vertex="1" parent="mq-lane">
          <mxGeometry x="130" y="50" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- MQ: Consumer -->
        <mxCell id="mq-consumer" value="TranslationSectionChangedConsumer&#xa;&#xa;1. Check feature flag: LangJsonGenerationEnabled&#xa;2. If disabled &#x2192; skip (log trace)&#xa;3. If enabled &#x2192; call TranslationFileGenerator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="mq-lane">
          <mxGeometry x="50" y="170" width="400" height="90" as="geometry" />
        </mxCell>

        <!-- MQ: Arrow queue to consumer -->
        <mxCell id="mq-queue-to-consumer" value="consume" style="edgeStyle=orthogonalEdgeStyle;html=1;fontStyle=2;fontSize=10;" edge="1" parent="mq-lane" source="mq-queue" target="mq-consumer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MQ: Feature Flag Decision -->
        <mxCell id="mq-flag-check" value="LangJsonGenerationEnabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="mq-lane">
          <mxGeometry x="140" y="300" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mq-consumer-to-flag" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="mq-lane" source="mq-consumer" target="mq-flag-check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MQ: Skip -->
        <mxCell id="mq-skip" value="Skip&#xa;(log trace)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;" vertex="1" parent="mq-lane">
          <mxGeometry x="380" y="310" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mq-flag-to-skip" value="false" style="edgeStyle=orthogonalEdgeStyle;html=1;fontStyle=2;fontSize=10;" edge="1" parent="mq-lane" source="mq-flag-check" target="mq-skip">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MQ: File Generator -->
        <mxCell id="mq-generator" value="TranslationFileGenerator.RegenerateAsync(sectionSlug, languageShortcut)&#xa;&#xa;1. Query Marten: WHERE SectionSlug = X AND LanguageShortcut = Y&#xa;2. Build dict: { slug: value }&#xa;3. Serialize to JSON&#xa;4. Write to wwwroot/translations/{lang}/{section}.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="mq-lane">
          <mxGeometry x="50" y="400" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="mq-flag-to-gen" value="true" style="edgeStyle=orthogonalEdgeStyle;html=1;fontStyle=2;fontSize=10;" edge="1" parent="mq-lane" source="mq-flag-check" target="mq-generator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MQ: Output File -->
        <mxCell id="mq-output" value="wwwroot/translations/&#xa;&#xa;cs/&#xa;  auth.json&#xa;  lang.json&#xa;  shared.json&#xa;  mmo-settings.json&#xa;en/&#xa;  auth.json&#xa;  lang.json&#xa;  ..." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=10;size=15;" vertex="1" parent="mq-lane">
          <mxGeometry x="130" y="540" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="mq-gen-to-output" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="mq-lane" source="mq-generator" target="mq-output">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MQ: JSON content example -->
        <mxCell id="mq-json-example" value="Example: cs/auth.json&#xa;&#xa;{&#xa;  &quot;auth-api-authService-invalidPassword&quot;: &quot;Neplatn&#233; heslo&quot;,&#xa;  &quot;auth-api-authService-validationTokenError&quot;: &quot;JWT token nen&#237; validn&#237;&quot;&#xa;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=10;size=15;" vertex="1" parent="mq-lane">
          <mxGeometry x="100" y="730" width="300" height="100" as="geometry" />
        </mxCell>

        <!-- ==================== CROSS-LANE ARROWS ==================== -->

        <!-- FE fetch JSON -> BE static middleware -->
        <mxCell id="arrow-fe-to-static" value="GET /translations/cs/auth.json" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;fontStyle=2;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-fetch-json" target="be-static">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- BE static serves file back to FE -->
        <mxCell id="arrow-static-to-fe" value="JSON response" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;dashed=1;fontStyle=2;fontSize=10;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="be-static" target="fe-fetch-json">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE create trans -> BE handler -->
        <mxCell id="arrow-fe-create" value="POST /api/lang/translations" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;strokeWidth=2;fontStyle=2;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-create-trans" target="be-trans-handlers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE update trans -> BE handler -->
        <mxCell id="arrow-fe-update" value="PUT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;strokeWidth=2;fontStyle=2;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-update-trans" target="be-trans-handlers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE list langs -> BE handler -->
        <mxCell id="arrow-fe-list-langs" value="GET languages" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=1;fontStyle=2;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-list-langs" target="be-lang-handlers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- FE list sections -> BE handler -->
        <mxCell id="arrow-fe-list-sections" value="GET sections" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=1;fontStyle=2;fontSize=9;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe-list-sections" target="be-section-query">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- BE publish -> RabbitMQ -->
        <mxCell id="arrow-be-to-mq" value="publish" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="be-publish" target="mq-queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MQ output -> BE static files (loop back) -->
        <mxCell id="arrow-output-to-static" value="Files served by static middleware" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#82b366;strokeWidth=2;dashed=1;fontStyle=2;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mq-output" target="be-static">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1170" y="820" />
              <mxPoint x="1170" y="40" />
              <mxPoint x="1090" y="40" />
              <mxPoint x="1090" y="235" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== LEGEND ==================== -->
