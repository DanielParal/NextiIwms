        <mxCell id="slug-box" value="module - feature - component - name&#xa;&#xa;Example: lang-api-translationService-translationWithIdDoesnotExist&#xa;&#xa;Parsed by string.Split(&quot;-&quot;) — no validation, no bounds checking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;" vertex="1" parent="1">
