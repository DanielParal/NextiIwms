  <diagram id="lang-module-flow" name="Update Language Flow (Auto-Translate)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="flow-title" value="UpdateLanguage Flow - Auto Translation Sequence" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="1. Client sends&#xa;PUT /api/lang/languages/{shortcut}&#xa;{ isActive: true }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="2. FluentValidation&#xa;validates IsActive != null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="s3" value="3. UpdateLanguageCommandHandler&#xa;loads Language by shortcut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="70" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="s4" value="4. Sets language.IsActive&#xa;and saves to DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="70" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="s5" value="5. Loads ALL translations&#xa;from database&#xa;(no filtering, full table)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 6 -->
        <mxCell id="s6" value="6. Groups by Slug&#xa;Filters groups where target&#xa;language is MISSING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="180" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Step 7 -->
        <mxCell id="s7" value="7. From filtered groups&#xa;selects only CZECH (Cs)&#xa;translations as source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="180" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 8 -->
        <mxCell id="s8" value="8. FOR EACH translation:&#xa;Call Google Translate API&#xa;Czech → Target Language&#xa;(sequential, one-by-one)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="180" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Step 9 -->
        <mxCell id="s9" value="9. If Google API fails:&#xa;swallow exception,&#xa;use original Czech value&#xa;as fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 10 -->
        <mxCell id="s10" value="10. Create new Translation&#xa;entity for target language&#xa;with translated value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="300" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- Step 11 -->
        <mxCell id="s11" value="11. unitOfWork.Add(item)&#xa;for each new translation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- Step 12 -->
        <mxCell id="s12" value="12. SaveChangesAsync()&#xa;Return Updated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="300" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s1" target="s2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s2" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s3" target="s4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s4" target="s5" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="150" />
              <mxPoint x="40" y="150" />
              <mxPoint x="40" y="210" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s5" target="s6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s6" target="s7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s7" target="s8" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a89" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s8" target="s9" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1050" y="270" />
              <mxPoint x="40" y="270" />
              <mxPoint x="40" y="330" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a910" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s9" target="s10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1011" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s10" target="s11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a1112" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="s11" target="s12" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Issue callouts -->
        <mxCell id="issue1" value="ISSUE: Full table load&#xa;into memory" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="issue2" value="ISSUE: Czech hardcoded&#xa;as source language" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="issue3" value="ISSUE: Sequential API calls&#xa;(no batching)" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="400" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="issue4" value="ISSUE: Silent error swallowing&#xa;No retry / no partial state" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="400" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="issue5" value="ISSUE: All in single&#xa;HTTP request (SRP)" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;size=10;position=0.5;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="400" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Startup Seed Flow -->
        <mxCell id="seed-title" value="Startup Seed Flow" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="350" y="500" width="300" height="25" as="geometry" />
        </mxCell>

        <mxCell id="seed1" value="App Startup&#xa;UseLangModule()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="130" height="50" as="geometry" />
        </mxCell>
        <mxCell id="seed2" value="EF Core&#xa;MigrateAsync()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="540" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="seed3" value="LanguagesSeed&#xa;Seeds 12 languages&#xa;(all IsActive=false)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="540" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="seed4" value="TranslationsSeed&#xa;Reflects IErrorComponent&#xa;SlugProvider classes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="540" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="seed5" value="Creates Czech&#xa;translations from&#xa;Error.Code / .Description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="540" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sa12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="seed1" target="seed2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sa23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="seed2" target="seed3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sa34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="seed3" target="seed4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sa45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeWidth=2;" edge="1" source="seed4" target="seed5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Seed note -->
        <mxCell id="seed-note" value="Note: Seed runs as fire-and-forget (_ = app.SeedLangDatabaseAsync).&#xa;Failure is caught and logged as warning — app continues without translations." style="text;html=1;fontSize=10;fontStyle=2;fontColor=#CC0000;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="610" width="500" height="30" as="geometry" />
