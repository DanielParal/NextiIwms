{
  "BaseUrlSettings": {
    "App": "https://staging-iwms.jipocar.cz",
    "Api": "https://staging-iwms-api.jipocar.cz"
  },
  "CorsSettings": {
    "Origins": ["https://staging-iwms.jipocar.cz", "https://staging-iwms-vhla.jipocar.cz", "https://staging-iwms-sign.jipocar.cz"]
  },
  "AssetsSettings": {
    "BaseFolder": "/app/iwms/assets"
  },
  "MasstransitMessageDataSettings": {
    "BaseFolder": "/app/iwms/masstransitmessagedata",
    "TimeToLive": "12:00:00"
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "ApplicationInsights",
        "Args": {
          "connectionString": "InstrumentationKey=c421cf8a-7b7b-4c7a-a4ef-a863c23f1182;IngestionEndpoint=https://germanywestcentral-1.in.applicationinsights.azure.com/;LiveEndpoint=https://germanywestcentral.livediagnostics.monitor.azure.com/;ApplicationId=21e4794c-d096-40de-9dd2-2aeef2172d98",
          "telemetryConverter": "Serilog.Sinks.ApplicationInsights.TelemetryConverters.TraceTelemetryConverter, Serilog.Sinks.ApplicationInsights"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 10,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "iwms-staging"
    }
  },
  "EmailSendersSettings": {
    "Default": {
      "SendFrom": "no-reply@jipocar.cz",
      "DisplayName": "Jipocar No-reply"
    }
  }
}