{
  "ExternalTools": {
    "Git": "C:\\Program Files\\Git\\cmd\\git.exe",
    "AzCli": "C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin\\az.cmd",
    "DockerCompose": "C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker-compose.exe"
  },
  "AzureAcr": {
    "RegistryName": "jipocariwms",
    "Repositories": [
      {
        "ImageName": "iwmsbeapi",
        "LocalEnvKey": "IWMS_BE_API_IMAGE_NUMBER"
      },
      {
        "ImageName": "iwmsfeadmin",
        "LocalEnvKey": "IWMS_FE_ADMIN_IMAGE_NUMBER"
      },
      {
        "ImageName": "iwmsfevhla",
        "LocalEnvKey": "IWMS_FE_VHLA_IMAGE_NUMBER"
      },
      {
        "ImageName": "infofestaging",
        "LocalEnvKey": "INFO_FE_IMAGE_NUMBER"
      },
      {
        "ImageName": "infobe",
        "LocalEnvKey": "INFO_BE_IMAGE_NUMBER"
      },
      {
        "ImageName": "iwmsfesign",
        "LocalEnvKey": "IWMS_FE_SIGN_IMAGE_NUMBER"
      }
    ]
  },
  "AzureKeyVault": {
    "KeyVaultUrl": "https://kv-staging-jipocar-iwms.vault.azure.net/"
  },
  "FileConfiguration": {
    "VersionFilePrefix": "config-build",
    "EnvironmentFilePrefix": "config-environment",
    "RootDirectoryPath": "C:\\Users\\danie\\Documents\\Development\\Work\\Jipocar\\IWMS-deployment",
    "DeploymentFolder": "deployment"
  },
  "EnvConfiguration": {
    "IwmsFeVersions": [
      {
        "MajorVersion": "v2.4.",
        "ImageNumberLookupKey": "IWMS_FE_ADMIN_IMAGE_NUMBER",
        "VersionKey": "IWMS_FE_ADMIN_VERSION"
      },
      {
        "MajorVersion": "v2.4.",
        "ImageNumberLookupKey": "IWMS_FE_VHLA_IMAGE_NUMBER",
        "VersionKey": "IWMS_FE_VHLA_VERSION"
      },
      {
        "MajorVersion": "v2.4.",
        "ImageNumberLookupKey": "IWMS_FE_SIGN_IMAGE_NUMBER",
        "VersionKey": "IWMS_FE_SIGN_VERSION"
      }
    ]
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Users\\danie\\Documents\\Development\\Work\\Jipocar\\IWMS-deployment\\deployment\\deploylogs\\log-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrelationId:{CorrelationId}] [Class:{ClassName}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}