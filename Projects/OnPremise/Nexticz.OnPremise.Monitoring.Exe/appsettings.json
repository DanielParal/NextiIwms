{
  "MonitoringRunnerSettings": {
    "ExecutionInterval": "00:01:00"
  },
  "DockerMonitoringSettings": {
    "SuccessMessageForCloudAlerts": "Container Monitoring: All containers are running",
    "DockerUri": "npipe://./pipe/docker_engine",
    "ContainerNames": ["iwms-postgres", "iwms-rabbitmq", "iwms-mssql", "info-fe", "info-be", "iwms-be-api", "iwms-fe-vhla", "iwms-fe-admin", "iwms-proxy"],
    "DockerDesktopProcessName": "com.docker.backend"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{CorrelationId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:/Development/Work/Jipocar/IWMS-deployment/Iwms-monitoring-app/bin/Debug/net9.0/win-x64/logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600,
          "retainedFileCountLimit": 10,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}